# Copy to .env and fill in. .env is git-ignored.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNALIGN_SECRET_KEY=

# Optional overrides
# TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MAX_RESUME_BYTES=5242880

# RAG workflow (ai-workflow/)
# Default: GPT-4o-mini. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
RAG_LLM_PROVIDER=openai             # openai | huggingface | ollama
# Open-source alternative, hosted by Hugging Face
# HUGGINGFACEHUB_API_TOKEN=
# RAG_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# RAG_OLLAMA_MODEL=qwen2.5:7b-instruct
RAG_OPENAI_MODEL=gpt-4o-mini
